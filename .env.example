# FirstRecord configuration — placeholders only. Never commit real values.

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./data/firstrecord.db
# Directory for encrypted recordings and attachments (must NOT be publicly served).
STORAGE_DIR=./data/storage

# 32+ random bytes, base64 or hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-random-secret
# 32 random bytes, base64. Used for AES-256-GCM encryption of stored files.
STORAGE_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Public origin of the app (used for CSRF origin checks on API routes).
APP_ORIGIN=http://localhost:3000

# Demo mode: enables one-click demo sign-in and demo-data reset. MUST be false in production.
DEMO_MODE=true

# AI provider: "demo" (deterministic, no external calls) or "anthropic".
AI_PROVIDER=demo
# Required to send statement content to an external model. Only set true after
# your organization has authorized external processing of personal data.
AI_EXTERNAL_PROCESSING_AUTHORIZED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Upload limits
MAX_UPLOAD_MB=25
MAX_RECORDING_MB=200

# Email / SMS notification adapters (not configured = in-app only).
EMAIL_PROVIDER=none
SMS_PROVIDER=none

# On-device speech-to-text (Whisper in the browser). Audio never leaves the device.
# false = download model weights from the Hugging Face hub on first use (cached).
# true  = load models only from /public/models/ (for offline / locked-down networks).
NEXT_PUBLIC_WHISPER_LOCAL_MODELS=false

# Password for seeded sample accounts (12+ chars). If unset, a random one is generated and printed by `npm run db:seed`.
SEED_PASSWORD=

# --- Container hosting (Docker / Railway / Render) — see docs/DEPLOYMENT.md ---
# In the container DATABASE_PATH=/data/firstrecord.db and STORAGE_DIR=/data/storage are preset.
# Judges' evaluation account, created on boot if it does not exist (password 12+ chars).
JUDGE_EMAIL=
JUDGE_PASSWORD=
JUDGE_NAME=Hackathon Judges
# Optional overrides (defaults: station_admin / CNT)
JUDGE_ROLE=
JUDGE_STATION=

# --- SOS phone notifications (optional) ---
# Web Push for SOS alerts. Generate a pair with: npx web-push generate-vapid-keys
# Without these, SOS alerts still sound a siren in open app tabs; no phone notifications are sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:admin@example.org

# Voice assistant (Gnani Vachana STT/TTS) — server-side only, never commit a real key
GNANI_API_KEY=
