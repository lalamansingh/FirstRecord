{
  "name": "firstrecord",
  "version": "1.0.0",
  "private": true,
  "description": "FirstRecord — police-station case management and statement recording system",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:reset": "tsx --conditions=react-server scripts/seed.ts --reset",
    "user:create": "tsx --conditions=react-server scripts/create-user.ts",
    "retention:run": "tsx --conditions=react-server scripts/retention.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "docs:permissions": "tsx --conditions=react-server scripts/gen-permissions-doc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@huggingface/transformers": "^3.8.1",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
